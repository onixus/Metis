{
  "realm": "metis",
  "enabled": true,
  "clients": [
    {
      "clientId": "metis-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/callback",
        "http://localhost:8082/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/login##http://localhost:8082/login"
      },
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "metis-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "metis-web",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "products",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "products",
            "claim.name": "products",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "finance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "finance",
            "claim.name": "finance",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "cpo"
      },
      {
        "name": "pm"
      },
      {
        "name": "dev_lead"
      },
      {
        "name": "marketing"
      },
      {
        "name": "finance"
      },
      {
        "name": "compliance"
      },
      {
        "name": "presale"
      },
      {
        "name": "admin"
      }
    ]
  },
  "users": [
    {
      "username": "cpo",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "metis-dev-only"
        }
      ],
      "realmRoles": [
        "cpo"
      ]
    },
    {
      "username": "pm-vm",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "metis-dev-only"
        }
      ],
      "realmRoles": [
        "pm"
      ],
      "attributes": {
        "products": [
          "vm"
        ]
      }
    },
    {
      "username": "pm-edr",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "metis-dev-only"
        }
      ],
      "realmRoles": [
        "pm"
      ],
      "attributes": {
        "products": [
          "edr"
        ]
      }
    },
    {
      "username": "pm-soar",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "metis-dev-only"
        }
      ],
      "realmRoles": [
        "pm"
      ],
      "attributes": {
        "products": [
          "soar"
        ]
      }
    },
    {
      "username": "presale",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "metis-dev-only"
        }
      ],
      "realmRoles": [
        "presale"
      ]
    },
    {
      "username": "admin-metis",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "metis-dev-only"
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "finance",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "metis-dev-only"
        }
      ],
      "realmRoles": [
        "finance"
      ],
      "attributes": {
        "finance": [
          "full"
        ]
      }
    }
  ]
}
